# Frontend-safe public values. These may appear in running-config.js.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_ANON_KEY
RUNNING_AUTH_EMAIL=running-dashboard@example.com

# Server-side Edge Function secrets. Never put these in frontend code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY
RUNNING_USER_ID=00000000-0000-0000-0000-000000000000
RUNNING_USER_EMAIL=running-dashboard@example.com
RUNNING_INGESTION_SECRET=replace-with-a-long-random-token
OPENAI_API_KEY=YOUR_SERVER_SIDE_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
